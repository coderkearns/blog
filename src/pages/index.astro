---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base title="coderkearns">
  <section class="home-hero">
    <h1>hi, i'm coderkearns ✦</h1>
    <p>writing about code, projects, and things i find interesting.</p>
  </section>

  <section>
    <p class="posts-heading">recent writing</p>
    <ul class="post-list">
      {
        posts.map((post) => (
          <li class="post-item">
            <a href={`${base}/${post.id}/`}>
              <div class="post-item-meta">
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </time>
              </div>
              <p class="post-item-title">{post.data.title}</p>
              {post.data.description && (
                <p class="post-item-description">{post.data.description}</p>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
